# -----------------------------------------------------------------------------
# PACHOOS backend - environment template
# Copy to `.env` and fill in local values. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
DJANGO_ENV=dev                      # dev | prod
DJANGO_SECRET_KEY=change-me          # 50+ random chars in prod
DJANGO_DEBUG=true                    # must be false in prod
ALLOWED_HOSTS=localhost,127.0.0.1    # comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (dev defaults to SQLite so the app runs with zero infra) -----
# Uncomment the block below to use PostgreSQL in dev/prod:
# DATABASE_URL=postgres://pachoos:pachoos@localhost:5432/pachoos

# --- Cache / broker --------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# --- Firebase Authentication (Google identity) -----------------------------
# Required: the Admin SDK verifies Google ID tokens signed by Firebase.
# Provide the service account as either a path to a JSON file or the JSON itself.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS=

# --- Payments / Maps / AI (leave blank in dev -> sandbox/mock mode) --------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=

# --- Email backend (transactional notifications + password-reset links) ----
# Gmail SMTP example: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend,
# EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=true.
# EMAIL_HOST_PASSWORD must be a Google App Password (16 chars) for EMAIL_HOST_USER.
# DEFAULT_FROM_EMAIL MUST be the same Gmail address as EMAIL_HOST_USER (or a
# verified Google alias) — Gmail refuses senders it does not own, which fails
# delivery silently from the user's perspective.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=PACHOOS <no-reply@pachoos.com>

# --- Password recovery -----------------------------------------------------
FRONTEND_URL=http://localhost:5173   # base URL used to build reset links
PASSWORD_RESET_TIMEOUT=86400         # seconds a reset token stays valid; the
                                     # reset email says "24 hours", so keep
                                     # this at 86400 unless the copy changes

# --- Storage ---------------------------------------------------------------
# MEDIA_STORAGE=local                # local | s3 | cloudinary
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Security headers ------------------------------------------------------
# SECURE_SSL_REDIRECT=false
# HSTS_SECONDS=31536000