# Frontend environment template (copy to .env)
# API base URL. In dev, leave empty to use the Vite proxy to Django.
VITE_API_URL=
# Firebase web config (phone OTP + Google sign-in). Required for customer auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Razorpay test key (used at checkout in later phases)
VITE_RAZORPAY_KEY_ID=